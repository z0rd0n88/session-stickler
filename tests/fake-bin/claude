#!/usr/bin/env python3
"""Stand-in for `claude` in tests/smoke.sh. Takes `--settings <dir>/settings.json <prompt>`, answers
"echo: <prompt>", and fires the settings' Stop hook the way Claude Code does: the Stop event JSON
on the hook's stdin. Then it answers each prompt typed into its pane the same way.

env: FAKE_MB=0 (memory to hold, to give children different sizes)  FAKE_DELAY=0.5 (seconds per reply)
     FAKE_FAIL=<error> (end the first turn through the StopFailure hook instead, as an API error does)
A prompt containing ASK-PERMISSION shows a permission prompt first; the next line typed answers it
(empty or "1" = approved), recorded as <dir>/approved or <dir>/denied. A prompt containing SLOW
takes 3 s. A prompt starting with "/" is a slash command: it writes to the transcript but runs no turn
(no Stop event, no footer), as /model or /config do; "/picker" also opens a picker whose footer
reads "s to use this session only · Enter to save · Esc to cancel", and the next line typed picks
(recorded as <dir>/picked).

The screen is drawn as Claude Code draws it: output above, then the input box between two rules,
then a status line: "⏵⏵ auto mode on", plus " · N shell(s)" while background shells run (never for a
foreground command) and " · esc to interrupt" while a turn runs. Turns run one at a time.

Background shells (env FAKE_TAG names the marker so parallel suites don't collide). A prompt with
  BACKGROUND             starts a shell as the Bash tool does in the background (`bash -c 'source
                         .../.claude/shell-snapshots/snapshot-bash-<tag>.sh; sleep 4; true'`),
                         listed in the status line, and ends its turn ("echo: started (...)"); when
                         the shell exits, after a 1.2 s gap, a turn of its own replies
                         "echo: background finished", as Claude Code does
  BACKGROUND-LATE        the shell (1 s) ends while the turn is still running (3 s); the turn of
                         its own still follows the Stop, 1.2 s later
  BACKGROUND-NOFOLLOW    a 2 s shell, and no turn follows it
  BACKGROUND-FOREVER     a 60 s shell (longer than any test waits), no turn follows
  BACKGROUND-TREEONLY    like BACKGROUND, but the status line never lists it
  BACKGROUND-FOOTERONLY  like BACKGROUND, but only the status line lists it (no process)
  BACKGROUND-AGENT       a background subagent waiting on a monitor, as seen live: a "◯ general-purpose"
                         row under the status line and " · 1 monitor" in it, for 4 s, while its own
                         command runs as an unlisted Bash-tool shell under claude; no turn follows
It also starts one `sleep` child, so holds can be checked across a process tree."""
import json
import os
import re
import subprocess
import sys
import threading
import time

args = sys.argv[1:]
settings = args[args.index("--settings") + 1]
prompt = args[-1]
hooks = json.load(open(settings))["hooks"]
hook = hooks["Stop"][0]["hooks"][0]["command"]
fail = os.environ.get("FAKE_FAIL")
transcript = os.path.join(os.path.dirname(settings), "fake-transcript.jsonl")
ballast = bytearray(int(os.environ.get("FAKE_MB", "0")) * 1024 * 1024)
for i in range(0, len(ballast), 4096):
    ballast[i] = 1   # touch every page so it counts as resident
helper = subprocess.Popen(["sleep", "100000"])
delay = float(os.environ.get("FAKE_DELAY", "0.5"))


TAG = os.environ.get("FAKE_TAG", "fake")
RULE = "─" * 78
history = ["fake claude ready"]
shells = []                     # background shells: {"proc": Popen or None, "listed": bool}
agents = []                     # background subagents, each waiting on one monitor
turn_lock = threading.Lock()    # one turn at a time
draw_lock = threading.RLock()   # one redraw at a time
busy = False


def draw():
    with draw_lock:
        listed = sum(1 for sh in shells if sh["listed"])
        status = "  ⏵⏵ auto mode on" + (f" · {listed} shell{'s' if listed > 1 else ''}" if listed else "") \
            + (f" · {len(agents)} monitor" if agents else "") + (" · esc to interrupt" if busy else "")
        rows = ["  ● main"] + [f"  ◯ general-purpose  waiting on 1 monitor · {a}" for a in agents] if agents else []
        print("\x1b[2J\x1b[H" + "\n".join(history[-15:] + ["", RULE, "❯ ", RULE, status] + rows), flush=True)


def say(line):
    with draw_lock:
        history.append(line)
        draw()


def background(text):
    kind = next((k for k in ("LATE", "NOFOLLOW", "FOREVER", "TREEONLY", "FOOTERONLY", "AGENT")
                 if f"BACKGROUND-{k}" in text), "")
    if kind == "AGENT":
        agents.append("Probe agent")
        # the subagent's own (foreground) command: a Bash-tool shell under claude, unlisted
        sub = subprocess.Popen(["bash", "-c", f"source /nonexistent/.claude/shell-snapshots/snapshot-bash-{TAG}.sh 2>/dev/null; sleep 4; true"])

        def agent_done():
            sub.wait()
            with draw_lock:
                agents.remove("Probe agent")
                draw()

        threading.Thread(target=agent_done, daemon=True).start()
        return f"started ({text})"
    secs = {"LATE": 1, "NOFOLLOW": 2, "FOREVER": 60}.get(kind, 4)
    # `; true` keeps bash from exec'ing sleep (and losing its argv), as the Bash tool's own trailing
    # commands do.
    proc = None if kind == "FOOTERONLY" else subprocess.Popen(
        ["bash", "-c", f"source /nonexistent/.claude/shell-snapshots/snapshot-bash-{TAG}.sh 2>/dev/null; sleep {secs}; true"])
    sh = {"proc": proc, "listed": kind != "TREEONLY"}
    shells.append(sh)

    def finish():
        proc.wait() if proc else time.sleep(secs)
        with draw_lock:
            shells.remove(sh)
            draw()
        if kind in ("NOFOLLOW", "FOREVER"):
            return
        with turn_lock:   # waits for a turn that is running, as Claude Code queues it
            pass
        time.sleep(1.2)   # Claude Code starts its own turn about a second after the shell ends
        answer("background finished")

    threading.Thread(target=finish, daemon=True).start()
    return f"started ({text})"


def answer(text, error=None):
    with open(transcript, "a") as f:
        f.write(json.dumps({"type": "user", "text": text}) + "\n")
    if text.startswith("/"):
        if text.startswith("/picker"):
            print(" Select model\n ❯ 1. Default\n   2. Other\n\n s to use this session only · Enter to save · Esc to cancel", flush=True)
            choice = sys.stdin.readline()   # read before creating the file: a test checks it exists
            open(os.path.join(os.path.dirname(settings), "picked"), "w").write(choice)
        say(f"  ⎿  ran {text}")
        return
    if "ASK-PERMISSION" in text:
        # A permission prompt, as Claude Code draws it. Enter picks the highlighted "1. Yes".
        print(" Do you want to proceed?\n ❯ 1. Yes\n   2. No\n\n Esc to cancel · Tab to amend", flush=True)
        choice = sys.stdin.readline()
        # A dialog ignores pasted text (as Claude Code's does) and acts on the keys: Enter alone, or "1", approves.
        keys = re.sub(r"\x1b\[200~.*?\x1b\[201~", "", choice, flags=re.S).strip()
        verdict = "approved" if keys in ("", "1") else "denied"
        open(os.path.join(os.path.dirname(settings), verdict), "w").write(choice)
        text = f"{verdict} ({text})"
    turn(text, error)


def turn(text, error=None):
    global busy
    with turn_lock:
        busy = True
        history.append("❯ " + text)
        draw()
        if "BACKGROUND" in text:
            text = background(text)
            draw()
        steps = 30 if ("SLOW" in text or "BACKGROUND-LATE" in text) else int(delay * 10)
        for _ in range(steps):   # small steps, so time held is lost
            time.sleep(0.1)
        busy = False
        if error:
            history.append("API Error: " + error)
            event = {"session_id": "fake", "transcript_path": transcript, "error": error}
            cmd = hooks["StopFailure"][0]["hooks"][0]["command"]
        else:
            reply = "echo: " + text
            history.append(reply)
            event = {"session_id": "fake", "transcript_path": transcript, "last_assistant_message": reply}
            cmd = hook
        draw()
        subprocess.run(cmd, shell=True, input=json.dumps(event), text=True, check=False)


# Ask for bracketed paste, as Claude Code does: a paste then arrives between ESC[200~ and ESC[201~,
# and newlines inside it belong to the prompt instead of submitting it.
print("\x1b[?2004h", end="", flush=True)
draw()
answer(prompt, fail)
START, END = "\x1b[200~", "\x1b[201~"
pending, in_paste = "", False
while True:
    line = sys.stdin.readline()
    if line == "":
        break
    if START in line:
        in_paste, line = True, line.replace(START, "")
    if END in line:
        in_paste, line = False, line.replace(END, "")
    pending += line
    if not in_paste and pending.strip():
        answer(pending.strip("\n"))
        pending = ""
helper.kill()
for sh in shells:
    if sh["proc"]:
        sh["proc"].kill()
