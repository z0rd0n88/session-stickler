#!/usr/bin/env bash
# session-relay: Headless and Desktop-friendly terminal bridge for Claude Code sessions.
# Allows sending follow-up prompts, inspecting live terminal output, and listing active
# sessions without requiring an interactive TTY or `tmux attach`.
#
# Commands:
#   session-relay list                       List managed sessions and latest status
#   session-relay send <window> "<prompt>"   Send a message directly into an agent pane
#   session-relay read <window> [lines]      Read recent terminal lines from a session
#   session-relay kill <window>              Close an agent session window
#
set -euo pipefail

TMUX_SESSION="${SWITCH_SESSION:-handoff}"

resolve_window() {
  local target="$1"
  if tmux list-windows -t "$TMUX_SESSION" -F "#{window_index}" 2>/dev/null | grep -qx "$target"; then
    echo "$TMUX_SESSION:$target"
    return 0
  fi
  if tmux list-windows -t "$TMUX_SESSION" -F "#{window_name}" 2>/dev/null | grep -qx "$target"; then
    echo "$TMUX_SESSION:$target"
    return 0
  fi
  echo "Error: window '$target' not found in tmux session '$TMUX_SESSION'" >&2
  return 1
}

cmd_list() {
  if ! command -v tmux >/dev/null || ! tmux has-session -t "$TMUX_SESSION" 2>/dev/null; then
    echo "No active sessions in tmux session '$TMUX_SESSION'."
    return 0
  fi

  printf "%-8s %-10s %-8s %s\n" "WINDOW" "NAME" "PID" "LATEST PREVIEW"
  printf "%-8s %-10s %-8s %s\n" "------" "----" "---" "--------------"

  while read -r win_idx win_name pane_pid; do
    local preview
    preview=$(tmux capture-pane -p -t "$TMUX_SESSION:$win_idx" 2>/dev/null | grep -v '^[[:space:]]*$' | tail -n 1 | tr '\n' ' ' | cut -c 1-60)
    printf "%-8s %-10s %-8s %s\n" "$win_idx" "$win_name" "$pane_pid" "$preview"
  done < <(tmux list-windows -t "$TMUX_SESSION" -F "#{window_index} #{window_name} #{pane_pid}")
}

cmd_send() {
  local target="${1:-}"
  local msg="${2:-}"
  [ -n "$target" ] && [ -n "$msg" ] || { echo "Usage: session-relay send <window> \"<prompt>\"" >&2; exit 1; }

  local win
  win=$(resolve_window "$target")
  tmux send-keys -t "$win" "$msg" Enter
  echo "Relayed prompt to $win:"
  echo "  $msg"
}

cmd_read() {
  local target="${1:-}"
  local lines="${2:-25}"
  [ -n "$target" ] || { echo "Usage: session-relay read <window> [lines]" >&2; exit 1; }

  local win
  win=$(resolve_window "$target")
  echo "=== Output from $win (tail $lines lines) ==="
  tmux capture-pane -p -t "$win" | tail -n "$lines"
}

cmd_kill() {
  local target="${1:-}"
  [ -n "$target" ] || { echo "Usage: session-relay kill <window>" >&2; exit 1; }

  local win
  win=$(resolve_window "$target")
  tmux kill-window -t "$win"
  echo "Closed session window: $win"
}

case "${1:-}" in
  list)   cmd_list ;;
  send)   shift; cmd_send "${1:-}" "${2:-}" ;;
  read)   shift; cmd_read "${1:-}" "${2:-25}" ;;
  kill)   shift; cmd_kill "${1:-}" ;;
  -h|--help|"")
    sed -n 2,10p "$0"
    exit 0
    ;;
  *)
    echo "Unknown command: $1" >&2
    exit 1
    ;;
esac
