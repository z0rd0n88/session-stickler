#!/usr/bin/env bash
# session-airspace: hold Claude children (SIGSTOP) when RAM runs short, release them (SIGCONT)
# when it frees up, so parallel sessions stop growing before WSL's OOM killer picks a victim.
#
# Commands:
#   session-airspace status                     RAM, then each child: FLYING/HOLDING, memory
#   session-airspace hold [--force] <target>    Freeze a child and every process under it.
#                                               A blast-off child needs --force (see below)
#   session-airspace release <target>           Resume it
#   session-airspace guard [--threshold 85] [--interval 5] [--once]
#                                               At >= threshold, hold the largest flying child;
#                                               at <= threshold-10, release one child it held.
#                                               It never holds a blast-off child
#
# <target> is the TARGET column of `session-relay list` ("session:index", or
# "socket/session:index" off the default tmux server), a window name (sw-ab12cd), or a bare
# window index in $SWITCH_SESSION (default handoff). Only Claude children resolve; PIDs do not.
# A hold stops growth; it does not free memory already in use (the kernel can swap it out).
# blast-off times each child with wall-clock seconds (JOB_CHILD_TIMEOUT, default 2 h), so time
# held counts against it, and its systemd slice already caps the children's memory.
set -euo pipefail

LIB="$(cd "$(dirname "$(readlink -f "$0")")/../lib" && pwd)"
# shellcheck source=lib/session-common.sh
. "$LIB/session-common.sh"

STATE_DIR="${XDG_RUNTIME_DIR:-/tmp}/session-airspace-$(id -u)"
HELD_FILE="$STATE_DIR/guard-held"   # "<pid> <starttime>" per child the guard itself held

usage() { sed -n '2,21p' "$0" | sed 's/^# \{0,1\}//'; }

# AIRSPACE_TEST_PCT replaces the measured RAM percentage; tests/smoke.sh uses it to simulate pressure.
ram() {
  local used total avail pct
  read -r used total avail pct < <(python3 "$LIB/session_panes.py" ram)
  echo "$used $total $avail ${AIRSPACE_TEST_PCT:-$pct}"
}

unholdable_msg() {
  echo "cannot hold $1: claude is the tmux pane's own process, and tmux resumes a stopped pane" \
       "process at once. Relaunch it with the current session-switcher (it wraps claude so" \
       "holds stick), or close it with: session-relay kill $1" >&2
}

cmd_status() {
  local used total avail pct rows
  read -r used total avail pct < <(ram)
  echo "RAM: ${used}MB used of ${total}MB (${pct}%), ${avail}MB available"
  rows=$(managed_rows)
  if [ -z "$rows" ]; then echo "No Claude children found on any tmux server."; return 0; fi
  echo
  local w
  w=$(awk -F'\t' 'BEGIN { m = 14 } length($1) > m { m = length($1) } END { print m }' <<<"$rows")
  printf "%-${w}s %-10s %-9s %-8s %-8s %6s  %s\n" TARGET NAME RUNNER PID STATUS RSS NOTE
  while IFS=$'\t' read -r target name _ cpid wrapped state rss _ _ _ _ _ runner _ _; do
    local status=FLYING note=""
    [ "$state" = held ] && status=HOLDING
    if [ "$wrapped" != 1 ]; then note="not holdable (old launch)"
    elif [ "$runner" = blast-off ]; then note="guard skips (blast-off timeout keeps running)"; fi
    printf "%-${w}s %-10s %-9s %-8s %-8s %5sM  %s\n" "$target" "$name" "$runner" "$cpid" "$status" "$rss" "$note"
  done <<<"$rows"
}

do_hold() {   # do_hold <target> <claude_pid> <wrapped>
  [ "$3" = 1 ] || { unholdable_msg "$1"; return 1; }
  hold_tree "$2"
  sleep 0.3
  if [ "$(proc_state "$2")" != T ]; then
    release_tree "$2"
    echo "hold on $1 did not stick (pid $2 is $(proc_state "$2")); left it running" >&2
    return 1
  fi
}

cmd_hold() {
  local force=0
  [ "${1:-}" = --force ] && { force=1; shift; }
  [ "${2:-}" = --force ] && force=1
  resolve_target "${1:-}"
  [ "$T_STATE" != held ] || { echo "$T_TARGET is already HOLDING"; return 0; }
  if [ "$T_RUNNER" = blast-off ]; then
    if [ "$force" -eq 0 ]; then
      echo "error: $T_TARGET is a blast-off child. Its runner keeps counting JOB_CHILD_TIMEOUT" \
           "(wall-clock, default 2 h) while it is held, then kills it and starts over, so the" \
           "held work is lost. blast-off.slice already caps its memory. To pause the whole job:" \
           "$(blast_off_stop_hint). To hold anyway: session-airspace hold --force $T_TARGET" >&2
      return 1
    fi
    echo "warning: $T_TARGET's JOB_CHILD_TIMEOUT clock keeps running while it is held" >&2
  fi
  do_hold "$T_TARGET" "$T_CLAUDE" "$T_WRAPPED"
  echo "HOLDING $T_TARGET ($T_NAME, pid $T_CLAUDE, ${T_RSS}MB). Resume: session-airspace release $T_TARGET"
}

cmd_release() {
  resolve_target "${1:-}"
  [ "$T_STATE" = held ] || { echo "$T_TARGET is already FLYING"; return 0; }
  release_tree "$T_CLAUDE"
  forget "$T_CLAUDE"
  echo "FLYING $T_TARGET ($T_NAME, pid $T_CLAUDE)"
}

# The guard only auto-releases children it held itself; a manual hold stays until you release it.
# Entries carry the process start time so a reused PID is never mistaken for the held child.
starttime() { awk '{ sub(/.*\) /, ""); print $20 }' "/proc/$1/stat" 2>/dev/null; }
remember()  { mkdir -p "$STATE_DIR"; echo "$1 $(starttime "$1")" >> "$HELD_FILE"; }
forget()    { [ -f "$HELD_FILE" ] || return 0; awk -v p="$1" '$1 != p' "$HELD_FILE" > "$HELD_FILE.tmp"; mv "$HELD_FILE.tmp" "$HELD_FILE"; }
# guard_held: live PIDs the guard holds, oldest first. Drops entries that no longer apply (the child
# exited, was killed with session-relay, or was resumed by someone else), so a stale line can never
# be mistaken for a hold. Always returns 0: under `set -e` a failed test on the last line would
# otherwise end the guard and strand its other holds.
guard_held() {
  [ -f "$HELD_FILE" ] || return 0
  local pid st keep=""
  while read -r pid st; do
    if [ -n "$pid" ] && [ "$(starttime "$pid")" = "$st" ] && [ "$(proc_state "$pid")" = T ]; then
      echo "$pid"; keep+="$pid $st"$'\n'
    fi
  done < "$HELD_FILE"
  printf '%s' "$keep" > "$HELD_FILE.tmp" && mv "$HELD_FILE.tmp" "$HELD_FILE"
  return 0
}

guard_usage() {
  echo "usage: session-airspace guard [--threshold PCT] [--interval SECS] [--once]" >&2
  echo "       session-airspace guard [PCT] [SECS] [--once]" >&2
}

guard_tick() {
  local threshold=$1 used total avail pct pct_int rows
  read -r used total avail pct < <(ram)
  pct_int="${pct%.*}"
  rows=$(managed_rows)

  if [ "$pct_int" -ge "$threshold" ]; then
    # Hold the largest flying, holdable child — but always leave one child flying, so the
    # fleet keeps making progress even when the pressure comes from outside it.
    local flying target cpid rss
    flying=$(awk -F'\t' '$6 != "held"' <<<"$rows" | grep -c . || true)   # blast-off ones count: they make progress
    if [ "$flying" -le 1 ]; then
      echo "[$(date +%T)] RAM ${pct}% >= ${threshold}%: $flying child flying; leaving it running"
      return 0
    fi
    # Never a blast-off child: a hold runs out its JOB_CHILD_TIMEOUT (see the header).
    read -r target cpid rss < <(awk -F'\t' '$6 != "held" && $5 == 1 && $13 != "blast-off" {print $1, $4, $7}' <<<"$rows" | sort -k3,3nr | head -1) || true
    if [ -z "${cpid:-}" ]; then
      echo "[$(date +%T)] RAM ${pct}% >= ${threshold}%: no holdable child (old launches cannot be held; blast-off children are left to their slice)"
      return 0
    fi
    # Record first: a signal during the hold must find this child in the list guard_exit releases.
    # guard_held ignores an entry whose process is not stopped, so a failed hold leaves nothing behind.
    remember "$cpid"
    if do_hold "$target" "$cpid" 1; then
      echo "[$(date +%T)] RAM ${pct}% >= ${threshold}%: HOLDING $target (pid $cpid, ${rss}MB)"
    else
      forget "$cpid"
    fi
  elif [ "$pct_int" -le "$((threshold - 10))" ]; then
    local pid
    pid=$(guard_held); pid=${pid%%$'\n'*}   # no `| head -1`: SIGPIPE plus pipefail would end the guard
    [ -n "$pid" ] || return 0
    release_tree "$pid"
    forget "$pid"
    echo "[$(date +%T)] RAM ${pct}% <= $((threshold - 10))%: FLYING pid $pid"
  fi
}

guard_exit() {
  local pid n=0
  for pid in $(guard_held); do release_tree "$pid"; forget "$pid"; n=$((n + 1)); done
  [ "$n" -eq 0 ] || echo "guard stopped: released $n child(ren) it was holding"
}

cmd_guard() {
  local threshold=85 interval=5 once=0 positional=()
  while [ "$#" -gt 0 ]; do
    case "$1" in
      --threshold)   [ "$#" -ge 2 ] || { guard_usage; exit 1; }; threshold="$2"; shift 2 ;;
      --threshold=*) threshold="${1#*=}"; shift ;;
      --interval)    [ "$#" -ge 2 ] || { guard_usage; exit 1; }; interval="$2"; shift 2 ;;
      --interval=*)  interval="${1#*=}"; shift ;;
      --once)        once=1; shift ;;
      -h|--help)     guard_usage; exit 0 ;;
      -*)            echo "Unknown guard option: $1" >&2; guard_usage; exit 1 ;;
      *)             positional+=("$1"); shift ;;
    esac
  done
  if [ "${#positional[@]}" -gt 2 ]; then
    echo "Too many arguments to guard: ${positional[*]}" >&2; guard_usage; exit 1
  fi
  [ "${#positional[@]}" -ge 1 ] && threshold="${positional[0]}"
  [ "${#positional[@]}" -ge 2 ] && interval="${positional[1]}"
  if ! [[ "$threshold" =~ ^[0-9]+$ ]] || [ "$threshold" -lt 11 ] || [ "$threshold" -gt 100 ]; then
    echo "Invalid threshold '$threshold': expected an integer percentage from 11 to 100" >&2; exit 1
  fi
  if ! [[ "$interval" =~ ^[0-9]+$ ]] || [ "$interval" -lt 1 ]; then
    echo "Invalid interval '$interval': expected a whole number of seconds (1 or more)" >&2; exit 1
  fi

  if [ "$once" -eq 1 ]; then guard_tick "$threshold"; return 0; fi
  # A guard that stops for any reason (Ctrl-C, SIGTERM, a hangup, or a `set -e` error) must not
  # leave its holds frozen: the EXIT trap releases them on every way out but SIGKILL.
  trap guard_exit EXIT
  trap 'exit 130' INT
  trap 'exit 143' TERM
  trap 'exit 129' HUP
  echo "guard: hold at >= ${threshold}% RAM, release at <= $((threshold - 10))%, every ${interval}s (Ctrl-C releases its holds)"
  while true; do
    guard_tick "$threshold"
    sleep "$interval"
  done
}

case "${1:-}" in
  status)  cmd_status ;;
  hold)    shift; cmd_hold "$@" ;;
  release) shift; cmd_release "${1:-}" ;;
  guard)   shift; cmd_guard "$@" ;;
  -h|--help|help|"") usage ;;
  *) echo "unknown command: $1" >&2; usage >&2; exit 1 ;;
esac
