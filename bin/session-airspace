#!/usr/bin/env bash
# session-airspace: Air Traffic Control for background Claude Code / agent sessions.
# Prevents WSL2 kernel OOM crashes by monitoring memory and holding/releasing sessions
# using POSIX SIGSTOP / SIGCONT signals.
#
# Commands:
#   session-airspace status                  Show memory usage and session holding states
#   session-airspace hold <pid|window>       Place a session into holding pattern (SIGSTOP)
#   session-airspace release <pid|window>    Clear a session to resume execution (SIGCONT)
#   session-airspace guard [--threshold 85]  Auto-monitor and manage memory pressure
#
set -euo pipefail

TMUX_SESSION="${SWITCH_SESSION:-handoff}"

get_system_ram() {
  python3 -c "
with open('/proc/meminfo') as f:
    m = dict(line.split(':', 1) for line in f if ':' in line)
total = int(m['MemTotal'].split()[0])
avail = int(m['MemAvailable'].split()[0])
used = total - avail
pct = (used / total) * 100
print(f'{used//1024} {total//1024} {avail//1024} {pct:.1f}')
"
}

get_process_info() {
  local pid="$1"
  if [ -r "/proc/$pid/status" ]; then
    python3 -c "
with open('/proc/$pid/status') as f:
    lines = dict(line.split(':', 1) for line in f if ':' in line)
state = lines.get('State', 'Unknown').strip().split()[0]
vm_rss = lines.get('VmRSS', '0 kB').strip().split()[0]
rss_mb = int(vm_rss) // 1024
label = 'HOLDING' if state == 'T' else 'FLYING'
print(f'{label} {rss_mb} {state}')
" 2>/dev/null || echo "UNKNOWN 0 ?"
  else
    echo "GONE 0 ?"
  fi
}

cmd_status() {
  read -r used_mb total_mb avail_mb pct < <(get_system_ram)
  echo "=== Airspace Status ==="
  echo "System RAM: ${used_mb}MB / ${total_mb}MB (${pct}% used, ${avail_mb}MB available)"
  echo ""
  printf "%-10s %-8s %-10s %-8s %s\n" "WINDOW" "PID" "STATE" "RSS" "DETAILS"
  printf "%-10s %-8s %-10s %-8s %s\n" "------" "---" "-----" "---" "-------"

  local found=0
  if command -v tmux >/dev/null && tmux has-session -t "$TMUX_SESSION" 2>/dev/null; then
    while read -r win_idx win_name pane_pid; do
      read -r label rss_mb state < <(get_process_info "$pane_pid")
      printf "%-10s %-8s %-10s %-8s %s\n" "$win_idx" "$pane_pid" "$label" "${rss_mb}MB" "$win_name"
      found=$((found + 1))
    done < <(tmux list-windows -t "$TMUX_SESSION" -F "#{window_index} #{window_name} #{pane_pid}")
  fi

  if [ "$found" -eq 0 ]; then
    echo "(No managed agent sessions found in tmux session: $TMUX_SESSION)"
  fi
}

resolve_pid() {
  local target="$1"
  if [[ "$target" =~ ^[0-9]+$ ]] && [ -d "/proc/$target" ]; then
    echo "$target"
    return 0
  fi
  # Try window index
  if command -v tmux >/dev/null && tmux has-session -t "$TMUX_SESSION" 2>/dev/null; then
    local pid
    pid=$(tmux list-windows -t "$TMUX_SESSION" -F "#{window_index} #{pane_pid}" | awk -v w="$target" '$1 == w {print $2}')
    if [ -n "$pid" ] && [ -d "/proc/$pid" ]; then
      echo "$pid"
      return 0
    fi
  fi
  echo "Error: unable to resolve target '$target' to an active PID" >&2
  return 1
}

cmd_hold() {
  local target="${1:-}"
  [ -n "$target" ] || { echo "Usage: session-airspace hold <pid|window>" >&2; exit 1; }
  local pid
  pid=$(resolve_pid "$target")
  kill -STOP "$pid"
  echo "Placed PID $pid ($target) into HOLDING pattern (SIGSTOP)"
}

cmd_release() {
  local target="${1:-}"
  [ -n "$target" ] || { echo "Usage: session-airspace release <pid|window>" >&2; exit 1; }
  local pid
  pid=$(resolve_pid "$target")
  kill -CONT "$pid"
  echo "Cleared PID $pid ($target) to FLY (SIGCONT)"
}

cmd_guard() {
  local threshold="${1:-85}"
  local interval="${2:-5}"
  local once=0
  if [ "${3:-}" = "--once" ] || [ "${1:-}" = "--once" ]; then
    once=1
    threshold=85
  fi

  echo "Airspace Guard active. Watching RAM (Threshold: ${threshold}%)..."
  while true; do
    read -r used_mb total_mb avail_mb pct < <(get_system_ram)
    local pct_int="${pct%.*}"

    if [ "$pct_int" -ge "$threshold" ]; then
      echo "[ALERT] RAM pressure at ${pct}% (>= ${threshold}%). Intervening..."
      # Find largest FLYING session to hold
      if command -v tmux >/dev/null && tmux has-session -t "$TMUX_SESSION" 2>/dev/null; then
        local target_pid=""
        local max_rss=0
        while read -r win_idx win_name pane_pid; do
          read -r label rss_mb state < <(get_process_info "$pane_pid")
          if [ "$label" = "FLYING" ] && [ "$rss_mb" -gt "$max_rss" ]; then
            max_rss="$rss_mb"
            target_pid="$pane_pid"
          fi
        done < <(tmux list-windows -t "$TMUX_SESSION" -F "#{window_index} #{window_name} #{pane_pid}")

        if [ -n "$target_pid" ]; then
          echo "Placing highest consumer PID $target_pid (${max_rss}MB) into HOLDING"
          kill -STOP "$target_pid"
        else
          echo "No flying sessions available to place on hold."
        fi
      fi
    elif [ "$pct_int" -le "$((threshold - 10))" ]; then
      # Room available, release one held session
      if command -v tmux >/dev/null && tmux has-session -t "$TMUX_SESSION" 2>/dev/null; then
        while read -r win_idx win_name pane_pid; do
          read -r label rss_mb state < <(get_process_info "$pane_pid")
          if [ "$label" = "HOLDING" ]; then
            echo "[CLEARANCE] RAM at ${pct}% (< $((threshold - 10))%). Releasing PID $pane_pid to FLY"
            kill -CONT "$pane_pid"
            break
          fi
        done < <(tmux list-windows -t "$TMUX_SESSION" -F "#{window_index} #{window_name} #{pane_pid}")
      fi
    fi

    [ "$once" -eq 1 ] && break
    sleep "$interval"
  done
}

case "${1:-}" in
  status) cmd_status ;;
  hold)   shift; cmd_hold "${1:-}" ;;
  release) shift; cmd_release "${1:-}" ;;
  guard)  shift; cmd_guard "${1:-85}" "${2:-5}" "${3:-}" ;;
  -h|--help|"")
    sed -n 2,10p "$0"
    exit 0
    ;;
  *)
    echo "Unknown command: $1" >&2
    exit 1
    ;;
esac
