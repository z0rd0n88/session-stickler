#!/usr/bin/env bash
# session-switcher: from inside a running Claude Code session, open a new one, hand it a brief,
# and get its first reply back. Mechanism copied from Orca's `worktree create --agent claude --prompt`:
#   brief = one shell argv, identity = env vars, return channel = Claude Stop hook -> done.json.
# Usage:  session-switcher <brief.md> [workdir]
#   env:  CLAUDE_FLAGS="--dangerously-skip-permissions"   SWITCH_SESSION=handoff
#         SWITCH_TIMEOUT=180 (seconds to wait for the first reply; a child that reads a long brief and
#           starts subagents can take over 2 minutes. Run from Claude's Bash tool, give that call a
#           longer timeout than this, e.g. 240000 ms: the tool's default 120 s cuts the wait short)
#         SWITCH_RAM_WARN=85 (warn before launching when RAM use is at or above this percent)
#         SWITCH_MODE=desktop|tmux (default: desktop when the parent runs in Claude Desktop; desktop opens the child there, no reply back)
#         SWITCH_ALLOW_TEMP=1 (launch even when the brief points into a session's scratchpad or task dirs)
#         SWITCH_BG_SETTLE=10 (a first turn that ends with a background shell running is followed
#           to the turn Claude starts when it finishes; once one was seen, the quiet seconds after
#           the last Stop before it counts as the reply. Still working at SWITCH_TIMEOUT: exit 2
#           with the reply so far. Background subagents and monitors get a note, not a wait)
# Follow up:  session-relay send <window> --wait "..."    Watch:  session-relay read <window>
set -euo pipefail
case "${1:-}" in -h|--help|"") sed -n 2,17p "$0"; exit 0;; esac
BRIEF="$1"
WORKDIR="$(cd "${2:-$PWD}" && pwd)"
TIMEOUT="${SWITCH_TIMEOUT:-180}"
[[ "$TIMEOUT" =~ ^[0-9]+$ ]] || { echo "SWITCH_TIMEOUT must be a whole number of seconds, got: $TIMEOUT" >&2; exit 1; }
BG_SETTLE="${SWITCH_BG_SETTLE:-10}"
[[ "$BG_SETTLE" =~ ^[0-9]+$ ]] || { echo "SWITCH_BG_SETTLE must be a whole number of seconds, got: $BG_SETTLE" >&2; exit 1; }
SESSION="${SWITCH_SESSION:-handoff}"
MODE="${SWITCH_MODE:-tmux}"
[ -z "${SWITCH_MODE:-}" ] && [ "${CLAUDE_CODE_ENTRYPOINT:-}" = claude-desktop ] && MODE=desktop
case "$MODE" in desktop|tmux) ;; *) echo "SWITCH_MODE must be desktop or tmux, got: $MODE" >&2; exit 1;; esac
if [ "$MODE" = tmux ]; then
  command -v claude >/dev/null || { echo "claude not on PATH" >&2; exit 1; }
  command -v tmux   >/dev/null || { echo "tmux not on PATH" >&2; exit 1; }
fi
command -v python3 >/dev/null || { echo "python3 not on PATH" >&2; exit 1; }
test -s "$BRIEF" || { echo "brief missing or empty: $BRIEF" >&2; exit 1; }
case "$(head -c1 "$BRIEF")" in -) echo "brief must not start with '-' (claude would parse it as a flag)" >&2; exit 1;; esac

# 0. Claude Code keeps a session's scratchpad and background-task output under
#    <tmp>/claude-<uid>/<project>/<session-uuid>/. Those dirs belong to that session and can be
#    cleaned up before the child reads them, so refuse a brief that points there and name each path.
TEMP_PATHS=$(grep -oE "[^[:space:]\"'\`()<>]*/claude-[0-9]+/[^/[:space:]]+/[0-9a-f]{8}(-[0-9a-f]{4}){3}-[0-9a-f]{12}(/[^[:space:]\"'\`()<>]*)?" "$BRIEF" \
  | sed 's/[.,;:!?]*$//' | sort -u || true)
if [ -n "$TEMP_PATHS" ]; then
  echo "the brief points into a Claude session's temporary dirs (scratchpad, task output), which may be gone when the child reads them:" >&2
  while IFS= read -r p; do echo "  $p"; done <<<"$TEMP_PATHS" >&2
  if [ "${SWITCH_ALLOW_TEMP:-0}" = 1 ]; then
    echo "launching anyway (SWITCH_ALLOW_TEMP=1)" >&2
  else
    echo "copy them somewhere durable (e.g. a gitignored dir in the repo), point the brief there, and rerun; SWITCH_ALLOW_TEMP=1 launches anyway" >&2
    exit 1
  fi
fi

# 1. another child adds memory; say so when RAM is already short (session-airspace can hold children)
awk -v warn="${SWITCH_RAM_WARN:-85}" '/^MemTotal:/ {t=$2} /^MemAvailable:/ {a=$2}
  END { p = 100 * (t - a) / t; if (p >= warn) printf "warning: RAM is %d%% used before launch; see: session-airspace status\n", p }' \
  /proc/meminfo >&2 || true

# 2. a private dir the parent watches (mktemp -d gives 0700)
DIR=$(mktemp -d "${XDG_RUNTIME_DIR:-/tmp}/switch.XXXXXX")
ID=${DIR##*/}
NAME="sw-${ID#switch.}"   # window name: stable, unlike an index; no '.', which tmux reads as a pane
PARENT="${CLAUDE_CODE_SESSION_ID:-$PPID}"

# Desktop mode: Desktop sessions take no --settings, so there is no Stop-hook return channel.
# Open Desktop's new-session page via a claude://code/new link and return. The brief stays on disk
# and the link carries only a pointer to it (no URL-length or quoting limits on the brief).
# Desktop only pre-fills the prompt: tested 2026-11-23 on WSL, it ignored folder= in both the
# \\wsl.localhost UNC and the Linux-path form and kept the last-used environment, and it does not
# send the prompt. So the workdir travels inside the prompt and the user picks the environment.
# ponytail: replace with a documented handoff if Desktop grows one that sets folder and sends.
if [ "$MODE" = desktop ]; then
  cp "$BRIEF" "$DIR/brief.md"
  enc() { python3 -c 'import sys, urllib.parse; print(urllib.parse.quote(sys.argv[1], safe=""))' "$1"; }
  URL="claude://code/new?q=$(enc "Work in $WORKDIR. Read $DIR/brief.md and follow it. It is your whole brief; you share no context with the session that wrote it.")"
  echo "asked Claude Desktop to open  workdir=$WORKDIR  brief=$DIR/brief.md"
  echo "in Desktop: pick an environment that can reach $WORKDIR, then press Enter to send the pre-filled prompt"
  echo "if no window appears, open this link: $URL"
  # opener failures are not fatal: the link above is the fallback (explorer.exe exits 1 even on success)
  if [ -n "${WSL_DISTRO_NAME:-}" ]; then explorer.exe "$URL" || true
  elif [ "$(uname)" = Darwin ]; then open "$URL" || true
  else xdg-open "$URL" || true; fi
  echo "no reply comes back in desktop mode; continue in Desktop (SWITCH_MODE=tmux gets the reply back)"
  exit 0
fi

# 3. return channel: Claude pipes the Stop event JSON into the hook; it lands as done.json
printf '{"hooks":{"Stop":[{"hooks":[{"type":"command","command":"cat > %s/done.json"}]}]}}\n' "$DIR" > "$DIR/settings.json"

# 4. the brief as ONE argv, POSIX-quoted the way Orca does it
Q="'$(sed "s/'/'\\\\''/g" "$BRIEF")'"

# 5. a tmux server whose environment does not say "you are inside Claude Code"
SCRUB=$(env | grep -o '^CLAUDE[A-Z_]*=' | sed 's/=$//; s/^/-u /')
tmux has-session -t "$SESSION" 2>/dev/null || env $SCRUB tmux new-session -d -s "$SESSION"

# 6. launch: identity in env, brief in argv. The trailing `; :` keeps the pane's shell alive as
#    claude's parent. Without it the shell execs claude, claude becomes the pane process, and tmux
#    sends SIGCONT to a stopped pane process at once, so session-airspace could never hold it.
WIN=$(tmux new-window -dP -t "$SESSION" -n "$NAME" -c "$WORKDIR" \
  -e SWITCH_ID="$ID" -e SWITCH_DIR="$DIR" -e SWITCH_PARENT="$PARENT" \
  "claude ${CLAUDE_FLAGS:-} --settings $DIR/settings.json $Q; :")
echo "launched  window=$NAME ($WIN)  workdir=$WORKDIR  dir=$DIR"
echo "watch:    session-relay read $NAME   (in a terminal: tmux attach -t $SESSION)"

# 7. wait for the child's first turn to end. A folder the child has not seen before shows the
#    "trust this folder?" dialog; answer it only for the parent's own working directory.
#    ponytail: screen scrape, same trick Orca's daemon uses; replace if claude grows a --trust flag.
#    A first turn can end with a shell still running in the background, and Claude Code starts a
#    new turn when it finishes: that one holds the real reply. So a Stop is the reply only once no
#    background shell runs, no turn runs, and, if one was seen at all (the footer lists it mid-turn
#    too), SWITCH_BG_SETTLE quiet seconds have passed. The same rules as `session-relay send --wait`.
LIB="$(cd "$(dirname "$(readlink -f "$0")")/../lib" && pwd)"
# The pane's own server: inside tmux (a run-job child calling this), that is $TMUX's, not "default".
PANE_INFO=$(tmux display -p -t "$WIN" "#{socket_path} #{pane_id} #{pane_pid}" 2>/dev/null || echo "default - 0")
read -r PANE_SOCK PANE_ID PANE_PID <<<"$PANE_INFO"
bg_status() { python3 "$LIB/session_panes.py" bg "$PANE_PID" "$PANE_SOCK" "$PANE_ID" 2>/dev/null || echo "0 0 /0 0"; }
stamp() { stat -c "%y %s" "$DIR/done.json" 2>/dev/null || true; }
SEEN_STOP="" STOPPED=0 BG_SEEN=0 QUIET=0 NOTED=0 REPLIED=0
for ((i=0; i<TIMEOUT; i++)); do
  read -r NEW BUSY _ AGENTS < <(bg_status)
  [ "${NEW:-0}" -gt 0 ] && BG_SEEN=1
  if [ -s "$DIR/done.json" ] && [ "$(stamp)" != "$SEEN_STOP" ]; then
    SEEN_STOP=$(stamp) STOPPED=1 QUIET=0
    if [ "${NEW:-0}" -gt 0 ] && [ "$NOTED" = 0 ]; then
      NOTED=1; echo "the child ended its turn with background shell(s) running; waiting for the turn they start"
    fi
  fi
  if [ "$STOPPED" = 1 ]; then
    if [ "${NEW:-0}" -gt 0 ] || [ "${BUSY:-0}" = 1 ]; then QUIET=0
    elif [ "$BG_SEEN" = 0 ]; then REPLIED=1; break
    elif [ "$QUIET" = 0 ]; then QUIET=$i
    elif [ $((i - QUIET)) -ge "$BG_SETTLE" ]; then REPLIED=1; break
    fi
  fi
  if [ "$WORKDIR" = "$PWD" ] && tmux capture-pane -p -t "$WIN" 2>/dev/null | grep -q "Yes, I trust this folder"; then
    tmux send-keys -t "$WIN" Down Enter; echo "accepted trust dialog for $WORKDIR"; sleep 2
  fi
  sleep 1
done
[ -s "$DIR/done.json" ] || {
  echo "timeout after ${TIMEOUT}s; the child is still running in window $NAME (raise SWITCH_TIMEOUT to wait longer)." >&2
  echo "check: session-relay read $NAME   reply when done: session-relay last $NAME" >&2
  echo "in a terminal: tmux attach -t $SESSION" >&2
  exit 2
}

# 8. surface the result: session id, transcript, and the child's last message
python3 - "$DIR/done.json" <<'PY'
import json, sys
ev = json.load(open(sys.argv[1]))
print("child session:", ev.get("session_id"))
print("transcript:   ", ev.get("transcript_path"))
print("--- child's last message ---")
print(ev.get("last_assistant_message") or "(none in Stop event; read the transcript)")
PY
# Background subagents and monitors are reported, not waited on: they can run for good.
if [ "${AGENTS:-0}" -gt 0 ]; then
  echo "note: the child still lists ${AGENTS} background agent(s) or monitor(s); not waited on. Claude may start more turns when they finish. Later: session-relay last $NAME"
fi
if [ "$REPLIED" = 0 ]; then
  echo "note: after ${TIMEOUT}s the child is still working: a background shell it started, or the turn that follows one. The reply above is the one so far; later: session-relay last $NAME"
  exit 2
fi
echo "--- follow up: session-relay send $NAME --wait \"<prompt>\"   close: session-relay kill $NAME"
